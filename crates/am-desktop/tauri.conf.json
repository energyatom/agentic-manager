{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentic Manager",
  "version": "0.0.1",
  "identifier": "app.agentic-manager.desktop",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:*",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    }
  },
  "mainBinaryName": "agentic-desktop"
}
