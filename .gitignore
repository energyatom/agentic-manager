# Superseded planning inputs: kept locally for the owner, never published.
_archive/

# Build and runtime output (`.agentic/` is the legacy in-project runtime
# folder older binaries wrote)
target/
node_modules/
.agentic/

# Rendered screenshots and private images (mockups are HTML; renders are local only)
*.png

# OS and editor noise
.DS_Store

# Python bytecode
__pycache__/

# Committed test fixtures are the exception to the image rule above.
!fixtures/**/*.png
!templates/**/*.png
!crates/am-desktop/icons/*.png

# Runtime state lives outside every project (AD-32, story 1.13); templates
# and fixtures ship their seed reference files under runtime-seed/, never
# .agentic/. A project's open marker is never committed.
.agentic-open

# Spike run outputs (owner file names and answers); never committed
crates/am-e2e/c4*.md
